<!DOCTYPE html>
<html lang="ro">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Programare vizită – Ferma BoCo</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>

    <%- include('../partials/navbar', { user, role, page: 'ferma' }) %>

    <div class="page-container">
        <p class="page-tag">Ferma noastră</p>
        <h1>Programează o vizită</h1>
        <p class="page-subtitle">Completează datele de mai jos și te vom contacta pentru confirmare.</p>

        <% if (locals.eroare) { %>
            <div class="auth-error" style="margin-bottom: 24px;"><%= eroare %></div>
        <% } %>

        <form method="POST" action="/ferma/vizita" class="form-block">
            <div class="form-row">
                <div class="field">
                    <label for="data">Data vizitei</label>
                    <input type="date" id="data" name="data" required>
                </div>
                <div class="field">
                    <label for="ora">Ora</label>
                    <input type="time" id="ora" name="ora" required>
                </div>
            </div>
            <div class="field">
                <label for="persoane">Număr de persoane</label>
                <input type="number" id="persoane" name="persoane" min="1" max="20" value="1" required>
            </div>
            <div class="field">
                <label for="mesaj">Mesaj (opțional)</label>
                <textarea id="mesaj" name="mesaj" placeholder="Orice detalii relevante..."></textarea>
            </div>
            <div style="display: flex; gap: 12px;">
                <button type="submit" class="btn-primary">Trimite cererea</button>
                <a href="/ferma" class="btn-secondary">Înapoi</a>
            </div>
        </form>
    </div>

</body>
</html>
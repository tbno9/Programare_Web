<!DOCTYPE html>
<html lang="ro">
<head>
    <meta charset="UTF-8">
    <title>Cămara Fermei BoCO</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <div id="continut-principal">
        <h1>Salut, fermierule <%= user %>!</h1>
        
        <p>Ai vizitat magazinul de <strong><%= views %></strong> ori în această sesiune.</p>

        <% if (ultimaVizita) { %>
            <p><small>Ultima ta activitate a fost la ora: <%= ultimaVizita %></small></p>
        <% } %>

       <h3>Produse disponibile:</h3>
        <table border="1" width="100%">
            <tr>
                <th>Produs</th>
                <th>Preț</th>
                <th>Stoc</th>
                <th>Descriere</th>
            </tr>
            <% produse.forEach(produs => { %>
            <tr>
                <td><%= produs.nume %></td>
                <td><%= produs.pret %> RON</td>
                <td><%= produs.stoc %></td>
                <td><%= produs.descriere %></td>
            </tr>
            <% }) %>
        </table>
        <br>
        <a href="/logout" style="color: red;">Ieșire din cont (Logout)</a>
    </div>
</body>
</html>
<!DOCTYPE html>
<html lang="ro">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login – Ferma BoCo</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>

    <div class="auth-page">
        <div class="auth-card">
            <p class="auth-brand">Ferma <span>BoCo</span></p>
            <p class="auth-slogan">„Marfă de Dănești - când mănânci, întinerești!"</p>

            <h2>Bun venit înapoi</h2>
            <p class="auth-subtitle">Introdu datele tale pentru a accesa magazinul</p>

            <% if (locals.eroare) { %>
                <div class="auth-error"><%= eroare %></div>
            <% } %>

            <form method="POST" action="/login">
                <div class="field">
                    <label for="email">Email</label>
                    <input type="email" id="email" name="email" placeholder="ion@exemplu.ro" required>
                </div>
                <div class="field">
                    <label for="password">Parolă</label>
                    <input type="password" id="password" name="password" placeholder="••••••••" required>
                </div>
                <button type="submit" class="btn-primary">Intră în cont</button>
            </form>

            <p class="auth-link">Nu ai cont? <a href="/register">Înregistrează-te</a></p>
        </div>
    </div>

</body>
</html>